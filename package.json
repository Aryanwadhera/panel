{
  "name": "panel",
  "version": "0.1.0",
  "description": "A calm, glanceable dashboard for Raspberry Pi. Widgets, webhooks and an AI daily brief, managed from your phone.",
  "license": "MIT",
  "type": "module",
  "main": "server/index.js",
  "bin": {
    "panel": "bin/panel"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "PANEL_DATA=./.data PORT=8080 node --watch server/index.js",
